# --- local secrets ----------------------------------------------------------
# XCMP key material, delta and kid. Never commit this; the real keys are
# property of Motorola Solutions and are unique per codeplug.
keys.json
*.key
secrets*.json

# --- radio inventory --------------------------------------------------------
# --names files map real radio ids to real names ("who is who" on your fleet).
names.json
radios.json

# --- captures and logs ------------------------------------------------------
# Everything below is a dump of what a real radio put on the wire: radio ids,
# aliases, serial numbers, model numbers and firmware revisions.
*.log
*.pcap
*.pcapng
*.cap
*.csv

